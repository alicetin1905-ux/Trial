# Copy to .env on the Mac Mini, fill in, then: chmod 600 .env
# Never commit .env. Never paste these values into chat.

# Jev (TypeSafe)
TYPESAFE_API_KEY=

# Opus 5.5, used only by the weekly review job
ANTHROPIC_API_KEY=

# Bybit Demo Trading API key, created on the bot's OWN sub-account.
# Permissions: trade only, withdrawals OFF, IP whitelist = the Mac Mini.
BYBIT_DEMO_KEY=
BYBIT_DEMO_SECRET=

# Telegram bot from @BotFather. The chat id is your own; commands from any other chat are ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Basic auth for the local dashboard
DASHBOARD_USER=
DASHBOARD_PASS=
